# YHOD settings.
#   On your own computer or server: copy this file to ".env" and fill it in.
#   On Vercel: do NOT upload a .env file. Enter the same names under
#              Project → Settings → Environment Variables, then redeploy.
# The Gemini key is only ever read by the server. Never put it in a file under public/.

# ── Required ─────────────────────────────────────────────────────────
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ── Where the records are kept ───────────────────────────────────────
# Nothing set, own computer/server: a SQLite file in the data/ folder. Nothing else is needed.
# Vercel (or any serverless host):  a function has no disk that lasts.
#   with a libSQL / Turso database  workspaces are kept there, and open from every device.
#                                   (On Vercel: Storage → Create Database → Turso adds both names by itself.)
#   without one: "device mode"      each workspace is kept, sealed, in the browser of the person it belongs to.
#                                   Nothing to set up, but a workspace exists only in that browser.
# TURSO_DATABASE_URL=libsql://your-database-your-name.turso.io
# TURSO_AUTH_TOKEN=
# Device mode is used by itself when no database is set. 0 = never: show "One step is missing" instead.
# YHOD_DEVICE_MODE=1

# 32-byte key (base64 or hex) that encrypts the health records, e.g. from:  openssl rand -base64 32
# Decide BEFORE the first record is saved, and then never change it:
#   set    → the key is kept apart from the data (recommended on Vercel)
#   unset  → YHOD makes one itself: in data/secret.key (own server) or inside the database (Vercel);
#            in device mode it is worked out from GEMINI_API_KEY, so replacing that key would make the
#            workspaces in people's browsers unreadable. Setting YHOD_DATA_KEY avoids that.
# YHOD will not start with a key that does not belong to the saved records. Keep a copy somewhere safe.
# YHOD_DATA_KEY=

# ── A server of your own (ignored on Vercel) ─────────────────────────
PORT=3000
HOST=0.0.0.0

# 1 = allow the site to be shown inside another site's frame (embedded previews). Use 0 in production.
ALLOW_EMBEDDING=0

# ── Optional ─────────────────────────────────────────────────────────
# Ordered model preference lists (YHOD falls back to the next one automatically).
# On the Gemini free tier the larger models allow only a few requests per day;
# with a paid key you can put your preferred model first in every list.
# GEMINI_TEXT_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.1-flash-lite
# GEMINI_VISION_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.1-flash-lite
# GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.6-flash
# GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Sulafat
# How the voice should say the brand name (subtitles always show "YHOD"), e.g. "Yod" or "Y. H. O. D."
# YHOD_SPOKEN_NAME=YHOD

# Daily AI allowances per signed-in person, and for the whole site
# AI_DAILY_TEXT=120
# AI_DAILY_IMAGE=20
# AI_DAILY_VOICE=80
# AI_DAILY_TRANSCRIBE=40
# AI_GLOBAL_DAILY=3000
